{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	// The build scripts are TypeScript that Node runs as it is, and are checked
	// with the rest
	"include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"],
	// The service worker runs outside a page and has its own settings beside it
	"exclude": ["src/service-worker"]
}
