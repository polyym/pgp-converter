{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	// Node runs the build scripts as TypeScript directly, so type-check them here
	"include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"],
	// Checked on its own (`npm run check`) with service worker globals, not the DOM
	"exclude": ["src/service-worker"]
}
