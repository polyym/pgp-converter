{
	"name": "pgp-app",
	"version": "4.0.1",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/write-csp.ts build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"lint": "svelte-kit sync && eslint .",
		"lint:fix": "svelte-kit sync && eslint . --fix",
		"format": "prettier --cache --write .",
		"format:check": "prettier --cache --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.14.0",
		"postcss": "^8.5.32",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"type": "module",
	"dependencies": {
		"openpgp": "^6.3.2",
		"qrcode": "^1.5.4"
	},
	"overrides": {
		"minimatch": "^11.0.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
