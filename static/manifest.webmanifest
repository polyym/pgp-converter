{
	"name": "PGP Converter",
	"short_name": "PGP Converter",
	"description": "Encrypt, decrypt, sign and verify PGP messages, and generate keys, in your browser.",
	"lang": "en-GB",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#09090b",
	"theme_color": "#09090b",
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{
			"src": "/icons/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{ "name": "Encrypt", "url": "/encrypt" },
		{ "name": "Decrypt", "url": "/decrypt" },
		{ "name": "Sign", "url": "/sign" },
		{ "name": "Verify", "url": "/verify" },
		{ "name": "Generate", "url": "/generate" }
	]
}
